@model CinemaBooking.Models.SuatChieu

@{
    ViewBag.Title = "Sơ Đồ Ghế";
}

<div class="container text-center" style="margin-top: 30px;">
    <h2 style="color: #f39c12; font-weight: bold;">MÀN HÌNH CHIẾU</h2>
    <div style="height: 10px; background-color: #f39c12; margin-bottom: 40px; box-shadow: 0 5px 15px rgba(243,156,18,0.5);"></div>

    @if (TempData["Message"] != null)
    {<div class="alert alert-success">@TempData["Message"]</div>}
    @if (TempData["Error"] != null)
    {<div class="alert alert-danger">@TempData["Error"]</div>}

    <div class="row justify-content-center">
        <div class="col-md-8" style="background-color: #2c3e50; padding: 30px; border-radius: 15px;">
            @foreach (var ghe in Model.GheNgois)
            {
                // Nếu ghế trống (false), hiển thị nút màu xanh có thể bấm đặt
                if (ghe.TrangThai == false)
                {
                    <form action="/DatVe/XacNhanDat" method="post" style="display:inline-block; margin: 5px;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="maGhe" value="@ghe.MaGhe" />
                        <input type="hidden" name="maSuatChieu" value="@Model.MaSuatChieu" />
                        <button type="submit" class="btn btn-outline-success" style="width: 60px; height: 50px; font-weight: bold;" title="Giá vé: @Model.GiaVe.ToString("#,##0") VNĐ">
                            @ghe.ViTriGhe
                        </button>
                    </form>
                }
                // Nếu ghế đã đặt (true), hiển thị nút màu đỏ và vô hiệu hóa (disabled)
                else
                {
                    <button class="btn btn-danger" disabled style="width: 60px; height: 50px; font-weight: bold; margin: 5px; opacity: 0.6;">
                        X
                    </button>
                }
            }
        </div>
    </div>
</div>