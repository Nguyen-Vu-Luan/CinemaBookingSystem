@model CinemaBooking.Models.Phim

@{
    ViewBag.Title = "Chi Tiết Phim - " + Model.TenPhim;
}

<div class="container" style="margin-top: 40px;">
    <div class="row">
        <div class="col-md-4">
            <img src="~/Content/Images/@Model.HinhAnh" class="img-fluid rounded shadow-lg" alt="@Model.TenPhim" onerror="this.src='https://via.placeholder.com/350x500?text=Chua+Co+Anh'" />
        </div>

        <div class="col-md-8">
            <h1 style="color: #f39c12; font-weight: bold;">@Model.TenPhim</h1>
            <p style="font-size: 1.1rem; color: #555;">🎬 <strong>Đạo diễn:</strong> @Model.DaoDien</p>
            <p style="font-size: 1.1rem; color: #555;">⏱ <strong>Thời lượng:</strong> @Model.ThoiLuong phút</p>

            <hr />
            <h3 style="color: #2c3e50; font-weight: bold; margin-bottom: 20px;">LỊCH CHIẾU & ĐẶT VÉ</h3>

            @if (Model.SuatChieus != null && Model.SuatChieus.Count > 0)
            {
                <div class="row">
                    @foreach (var suat in Model.SuatChieus)
                    {
                        <div class="col-md-4 mb-3">
                            <div class="card text-center shadow-sm" style="border: 2px solid #28a745; border-radius: 10px;">
                                <div class="card-body">
                                    <h5 class="card-title text-success font-weight-bold">@suat.PhongChieu</h5>
                                    <p class="card-text">@suat.ThoiGianChieu.ToString("HH:mm - dd/MM/yyyy")</p>
                                    <p class="card-text text-danger font-weight-bold">Giá: @suat.GiaVe.ToString("#,##0") VNĐ</p>

                                    <a href="/DatVe/ChonGhe?maSuatChieu=@suat.MaSuatChieu" class="btn btn-success btn-sm btn-block font-weight-bold">
                                        💺 Chọn Ghế Ngay
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-warning">
                    Bộ phim này hiện chưa có suất chiếu nào. Vui lòng quay lại sau!
                </div>
            }
        </div>
    </div>
</div>