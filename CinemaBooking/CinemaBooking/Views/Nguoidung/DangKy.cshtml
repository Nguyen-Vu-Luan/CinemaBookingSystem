@model CinemaBooking.Models.NguoiDung
@{ ViewBag.Title = "Đăng Ký Tài Khoản"; }

<div class="row justify-content-center" style="margin-top: 50px;">
    <div class="col-md-5">
        <div class="card shadow-lg" style="border-radius: 15px;">
            <div class="card-header text-center bg-dark text-warning">
                <h3 style="font-weight: 800; margin: 0;">📝 ĐĂNG KÝ</h3>
            </div>
            <div class="card-body">
                @if (ViewBag.ErrorRegister != null)
                {<div class="alert alert-danger">@ViewBag.ErrorRegister</div>}

                @using (Html.BeginForm("DangKy", "Nguoidung", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <div class="form-group">
                        <label class="font-weight-bold">Tài khoản</label>
                        @Html.TextBoxFor(m => m.TaiKhoan, new { @class = "form-control", @required = "required" })
                    </div>
                    <div class="form-group mt-3">
                        <label class="font-weight-bold">Mật khẩu</label>
                        @Html.PasswordFor(m => m.MatKhau, new { @class = "form-control", @required = "required" })
                    </div>
                    <div class="form-group mt-3 mb-4">
                        <label class="font-weight-bold">Họ và Tên</label>
                        @Html.TextBoxFor(m => m.HoTen, new { @class = "form-control", @required = "required" })
                    </div>
                    <button type="submit" class="btn btn-warning btn-block font-weight-bold">Tạo Tài Khoản</button>
                }
            </div>
            <div class="card-footer text-center">
                Đã có tài khoản? <a href="/Nguoidung/DangNhap" class="text-danger font-weight-bold">Đăng nhập</a>
            </div>
        </div>
    </div>
</div>