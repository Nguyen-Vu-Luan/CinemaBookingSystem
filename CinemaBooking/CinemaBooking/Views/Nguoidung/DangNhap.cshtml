@{ ViewBag.Title = "Đăng Nhập"; }

<div class="row justify-content-center" style="margin-top: 50px;">
    <div class="col-md-5">
        <div class="card shadow-lg" style="border-radius: 15px;">
            <div class="card-header text-center bg-dark text-warning">
                <h3 style="font-weight: 800; margin: 0;">🔑 ĐĂNG NHẬP</h3>
            </div>
            <div class="card-body">
                @if (ViewBag.ErrorLogin != null)
                {<div class="alert alert-danger">@ViewBag.ErrorLogin</div>}

                @using (Html.BeginForm("DangNhap", "Nguoidung", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <div class="form-group">
                        <label class="font-weight-bold">Tài khoản</label>
                        <input type="text" name="TaiKhoan" class="form-control" required />
                    </div>
                    <div class="form-group mt-3 mb-4">
                        <label class="font-weight-bold">Mật khẩu</label>
                        <input type="password" name="MatKhau" class="form-control" required />
                    </div>
                    <button type="submit" class="btn btn-success btn-block font-weight-bold">Đăng Nhập</button>
                }
            </div>
            <div class="card-footer text-center">
                Chưa có tài khoản? <a href="/Nguoidung/DangKy" class="text-info font-weight-bold">Đăng ký ngay</a>
            </div>
        </div>
    </div>
</div>